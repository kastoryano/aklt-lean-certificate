theorem coversLoop : ∀entry∈loopRootTrails, pack entry.2 ∈ rootMasksLoop := by
  rintro ⟨start,root⟩ hr
  obtain ⟨hs,he,hend⟩ := (mem_loopRootTrails_iff start root).mp hr
  have hb := (mem_anchors start).mp hs
  have hm := (mem_extensions_iff (next .corner) 5 [start] root).mpr he
  cases start with
  | a q r =>
    simp only [qCoord,rCoord] at hb
    have hq : (((q+2).toNat : ℕ) : ℤ)-2=q := by omega
    have hr : (((r+16).toNat : ℕ) : ℤ)-16=r := by omega
    have hh := checkLoopA ⟨(q+2).toNat,by omega⟩
      ⟨(r+16).toNat,by omega⟩
    simp only [hq,hr] at hh
    exact hh root hm hend
  | b q r =>
    simp only [qCoord,rCoord] at hb
    have hq : (((q+2).toNat : ℕ) : ℤ)-2=q := by omega
    have hr : (((r+16).toNat : ℕ) : ℤ)-16=r := by omega
    have hh := checkLoopB ⟨(q+2).toNat,by omega⟩
      ⟨(r+16).toNat,by omega⟩
    simp only [hq,hr] at hh
    exact hh root hm hend
end RootedKP.CachedPaths
