theorem checkSixA : ∀q : Fin 19,∀r : Fin 18,
    Leaf .corner (Vertex.a ((q.val : ℤ)-2) ((r.val : ℤ)-16)) →
    ∀trail∈extensions (next .corner) 6 [Vertex.a ((q.val : ℤ)-2) ((r.val : ℤ)-16)],
      endsAt (Leaf .corner) trail → pack trail ∈ rootMasksSix := by
  decide +kernel

theorem checkSixB : ∀q : Fin 19,∀r : Fin 18,
    Leaf .corner (Vertex.b ((q.val : ℤ)-2) ((r.val : ℤ)-16)) →
    ∀trail∈extensions (next .corner) 6 [Vertex.b ((q.val : ℤ)-2) ((r.val : ℤ)-16)],
      endsAt (Leaf .corner) trail → pack trail ∈ rootMasksSix := by
  decide +kernel

theorem coversSix : ∀root∈boundaryRootTrails 6, pack root ∈ rootMasksSix := by
  intro root hr
  obtain ⟨start,hs,he,hstart,hend⟩ := (mem_boundaryRootTrails_iff 6 root).mp hr
  have hb := (mem_anchors start).mp hs
  have hm := (mem_extensions_iff (next .corner) 6 [start] root).mpr he
  cases start with
  | a q r =>
    simp only [qCoord,rCoord] at hb
    have hq : (((q+2).toNat : ℕ) : ℤ)-2=q := by omega
    have hr : (((r+16).toNat : ℕ) : ℤ)-16=r := by omega
    have hh := checkSixA ⟨(q+2).toNat,by omega⟩
      ⟨(r+16).toNat,by omega⟩
    simp only [hq,hr] at hh
    exact hh hstart root hm hend
  | b q r =>
    simp only [qCoord,rCoord] at hb
    have hq : (((q+2).toNat : ℕ) : ℤ)-2=q := by omega
    have hr : (((r+16).toNat : ℕ) : ℤ)-16=r := by omega
    have hh := checkSixB ⟨(q+2).toNat,by omega⟩
      ⟨(r+16).toNat,by omega⟩
    simp only [hq,hr] at hh
    exact hh hstart root hm hend
end RootedKP.CachedPaths
